{
  "cli": {
    "version": ">= 27.10.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleRelease"
      },
      "cache": {
        "key": "v1-gradle-cache",
        "paths": [
          ".gradle",
          "android/.gradle"
        ]
      }
    },
    "production": {
      "autoIncrement": true,
      "cache": {
        "key": "v1-gradle-cache-prod",
        "paths": [
          ".gradle",
          "android/.gradle"
        ]
      }
    }
  },
  "submit": {
    "production": {}
  }
}
